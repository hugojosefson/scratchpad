{
  "name": "@hugojosefson/scratchpad",
  "version": "3.0.21",
  "description": "Testing project setup",
  "license": "MIT",
  "exports": {
    "./hello": "./src/hello.ts",
    ".": "./src/lib/mod.ts",
    "./example-usage": "./readme/example-usage.ts"
  },
  "fmt": {
    "useBraces": "always",
    "singleBodyPosition": "nextLine"
  },
  "lock": false,
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/cli": "jsr:@std/cli@^1.0.17",
    "@std/testing": "jsr:@std/testing@1.0.11",
    "regex-merge": "npm:regex-merge@^3.0.0"
  },
  "tasks": {
    "fmt": {
      "description": "Fix formatting.",
      "command": "deno fmt"
    },
    "format": {
      "description": "Check formatting.",
      "command": "deno fmt --check"
    },
    "check": {
      "description": "Run project checks.",
      "dependencies": [
        "format",
        "lint",
        "typecheck",
        "test",
        "publish-check"
      ]
    },
    "default": {
      "description": "Fix formatting, then run checks.",
      "command": "deno fmt && deno task check"
    },
    "all": {
      "description": "Run all checks.",
      "dependencies": [
        "check"
      ]
    },
    "publish-check": {
      "description": "Check JSR publication.",
      "command": "deno publish --dry-run --allow-dirty --check=all"
    },
    "test": {
      "description": "Run tests and report fresh coverage.",
      "command": "sh -c 'rm -rf coverage || exit $?; deno test --parallel --trace-leaks --coverage=coverage \"$@\"; test_status=$?; deno coverage coverage; report_status=$?; if test \"$test_status\" -ne 0; then exit \"$test_status\"; fi; exit \"$report_status\"' --"
    },
    "lint": {
      "description": "Fix lint locally; check lint in CI.",
      "command": "sh -c 'if test -n \"${CI:-}\"; then exec deno lint; else exec deno lint --fix; fi'"
    },
    "typecheck": {
      "description": "Type-check the project.",
      "command": "deno check"
    },
    "coverage": {
      "description": "Run tests and report fresh coverage.",
      "command": "deno task test"
    },
    "dev": {
      "description": "Run tests when source files change.",
      "command": "deno test --parallel --trace-leaks --watch"
    }
  },
  "minimumDependencyAge": {
    "age": 1440,
    "exclude": [
      "jsr:@hugojosefson/cli"
    ]
  },
  "publish": {
    "include": [
      "deno.json",
      "src/hello.ts",
      "src/lib/mod.ts",
      "readme",
      "README.md",
      "CHANGELOG.md",
      "LICENSE"
    ]
  }
}
